# Copy to app/.env.local (git-ignored) and fill in. Never commit real values.

# ── Network ────────────────────────────────────────────────────────────
# testnet (default) or mainnet. On mainnet also set NEXT_PUBLIC_RPC_URL and
# the contract IDs (see src/lib/config.ts).
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ── Platform key (server only) ─────────────────────────────────────────
# Verifies companies in the registry and adds credential leaves to the gate.
DVDND_ADMIN_SECRET=

# ── idOS (reusable KYC) ────────────────────────────────────────────────
# From the idOS developer console. Playground = test network.
NEXT_PUBLIC_IDOS_NETWORK_URL=https://nodes.playground.idos.network
NEXT_PUBLIC_IDOS_RELAY_URL=https://relay.playground.idos.network
NEXT_PUBLIC_IDOS_RELAY_CLIENT_ID=3a27ecd4-39d0-4740-9240-726fffa90f7c
# Issuer whose KYC credentials we accept (public).
NEXT_PUBLIC_IDOS_ACCEPTED_ISSUER_PUBLIC_KEY=
NEXT_PUBLIC_IDOS_ACCEPTED_ISSUER_ID=
# How idOS identifies us as the grantee of access grants (public).
NEXT_PUBLIC_IDOS_CONSUMER_PUBLIC_IDENTIFIER=
# Server-only secrets:
# Signs relay KYC links (ES512 private key, PEM).
IDOS_RELAY_PRIVATE_KEY=
# Consumer signing key; its public half is 1a8f58b2ab1400986b00bda8860ba9721aca925f5b72f0ab3466a29eda67d968.
IDOS_CONSUMER_AUTH_KEY=
# Consumer encryption key (base64 nacl box secret key) to decrypt shared credentials.
IDOS_CONSUMER_ENC_KEY=
